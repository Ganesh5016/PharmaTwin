# PharmaTwin AI - Environment Variables
# Copy this to .env and fill in your values

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=PharmaTwin AI
DEBUG=false
SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-this

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pharmatwin:pharmatwin123@localhost:5432/pharmatwin_db

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── ML Models ────────────────────────────────────────────────────────────────
MODEL_CACHE_DIR=./ml/saved_models

# ── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
REPORT_DIR=./reports

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://10.0.2.2:8000","*"]
